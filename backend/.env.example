# Matching thresholds
# The closest person's relative distance (their distance / their average distance
# to the other registered people / this scan's average) must be at or below this limit
MATCH_RELATIVE_LIMIT=0.90
# The closest person must also beat the second-closest person's relative distance by this much
MATCH_CLEAR_WINNER_MARGIN=0.02
# With one registered person, the plain distance must be at or below this cutoff
MATCH_DISTANCE_CUTOFF=0.12
